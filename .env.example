# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend / Public API
# For local docker-compose: http://localhost:8080
# For stand: http://slurm-talks-back.sXXXXXX.edu.slurm.io
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Security & App
JWT_SECRET_KEY=your_jwt_secret_key_here
MIGRATE_IN_CODE=true

# Monitoring / Fake metrics
SIMULATED_METRICS=false
SIMULATED_METRICS_INTERVAL=1m
SIMULATED_METRICS_TWEETS=10
SIMULATED_METRICS_USERS=10
