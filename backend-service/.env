# CHANGE ON YOUR POSTGRES USERNAME
POSTGRES_USER=postgres

# CHANGE ON YOUR POSTGRES PASSWORD IF EXIST
POSTGRES_PASSWORD=

# CHANGE ON YOUR POSTGRES DATABASE
POSTGRES_DB=postgres

# CHANGE ON YOUR POSTGRES HOST
POSTGRES_HOST=localhost

# CHANGE ON YOUR POSTGRES PORT
POSTGRES_PORT=5432

# CHANGE ON YOUR REDIS HOST:PORT
REDIS_ADDR=localhost:6379

# CHANGE ON YOUR REDIS PASSWORD IF EXIST
REDIS_PASSWORD=

# DEFAULT REDIS DB
REDIS_DB=0

# SUPER SECRET KEY FOR JWT
JWT_SECRET_KEY=your_secret_key

# MIGRATION IN PGSQL IN CODE
MIGRATE_IN_CODE=true

# ---- MONITORING
# FAKE METRICS FOR MONITORING
SIMULATED_METRICS=false

# SIMULATED_METRICS_INTERVAL
# example value 1s, 1m, 1h
SIMULATED_METRICS_INTERVAL=1m

# SIMULATED_METRICS_TWEETS
# auto create user in pgsql
SIMULATED_METRICS_TWEETS=10

# SIMULATED_METRICS_USERS
# auto create tweets in redis
SIMULATED_METRICS_USERS=10